# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/bugpilot

# Express server port
PORT=3001

# Frontend API URL
VITE_API_URL=http://localhost:3001/api

# Firebase Config (from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Comma-separated Firebase Auth email addresses allowed to access /admin
VITE_ADMIN_EMAILS=admin@example.com

# Comma-separated list of extra allowed origins for backend CORS (production frontend URL)
# ALLOWED_ORIGINS=https://your-frontend.vercel.app
